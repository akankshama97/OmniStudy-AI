# OmniStudy AI Environment Configuration
# Copy this file to server/.env.local (or server/.env) and set your Gemini API key.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/omnistudy

# Required: Google Gemini API Key from https://aistudio.google.com/apikey
# Read only by server code in server/.env.local (no NEXT_PUBLIC_ exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here
