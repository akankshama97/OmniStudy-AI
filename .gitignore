# ── Dependencies (Never push node_modules) ──
node_modules/
client/node_modules/
server/node_modules/

# ── Local Databases & Storage Data (CRITICAL - Never expose user data/IDs) ──
data/
server/data/
server/data/*
*.db
*.db-journal
*.sqlite
*.sqlite3
*.rdb
*.dump
*.sql
mongodb_data/
.mongo/

# ── Environment Variables & Secret API Keys (CRITICAL!) ──
.env
.env*
*.env
*.env.*
server/.env
server/.env*
server/*.env
client/.env
client/.env*
client/*.env
!.env.example
!server/.env.example

# ── Certificates, Private Keys & Auth Tokens ──
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
id_rsa*
*.token
token.json
credentials.json
serviceAccountKey*.json
firebase-adminsdk*.json
client_secret*.json

# ── Production Build Outputs ──
dist/
dist-ssr/
client/dist/
build/
client/build/
*.local

# ── Uploads & User Generated Files ──
uploads/
server/uploads/
downloads/
temp/
tmp/
.temp/

# ── Logs & Debugging ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor & IDE Configurations ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS Generated Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Temporary, Cache & Coverage Files ──
.cache/
.parcel-cache/
.eslintcache
coverage/
.nyc_output/
.vite/
client/.vite/
*.tsbuildinfo

# ── Extension & Distribution Archives ──
*.crx
*.xpi
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ── Local Generated PDFs & Exports ──
*.pdf
output/
exports/

# ── Secrets & Keystores ──
*.secret
*.secrets
secrets/
secrets*.json
*.keystore
*.jks
*.p8
service-account*.json
